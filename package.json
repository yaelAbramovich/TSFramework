{
  "name": "ts-framework",
  "version": "1.0.0",
  "description": "TypeScript + Playwright automation framework supporting UI and API tests",
  "scripts": {
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "docker:build": "docker compose build",
    "docker:test": "docker compose run --rm tests",
    "docker:test:api": "docker compose run --rm tests npm run test:api",
    "docker:test:ui": "docker compose run --rm tests npm run test:ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.12.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0"
  }
}
